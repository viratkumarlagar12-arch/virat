{
 "voice": "kokoro:hf_alpha",
 "speed": 1.34,
 "duration": 39.089,
 "sentences": [
  {
   "i": 0,
   "text": "लेह में दाल उबलती है...",
   "start": 0.0,
   "end": 1.236,
   "peak": 0.734
  },
  {
   "i": 1,
   "text": "फिर भी कच्ची क्यों?",
   "start": 1.486,
   "end": 2.543,
   "peak": 0.691
  },
  {
   "i": 2,
   "text": "ए, ऑक्सीजन कम?",
   "start": 2.943,
   "end": 4.012,
   "peak": 0.648
  },
  {
   "i": 3,
   "text": "बी, ठंड?",
   "start": 4.162,
   "end": 4.872,
   "peak": 0.632
  },
  {
   "i": 4,
   "text": "सी, प्रेशर कम?",
   "start": 5.022,
   "end": 6.008,
   "peak": 0.642
  },
  {
   "i": 5,
   "text": "जवाब एण्ड में।",
   "start": 6.308,
   "end": 7.277,
   "peak": 0.704
  },
  {
   "i": 6,
   "text": "लेह समुद्र से साढ़े तीन हज़ार मीटर ऊपर है।",
   "start": 7.777,
   "end": 10.406,
   "peak": 0.636
  },
  {
   "i": 7,
   "text": "वहाँ हवा का प्रेशर बस दो तिहाई।",
   "start": 10.656,
   "end": 12.494,
   "peak": 0.596
  },
  {
   "i": 8,
   "text": "पानी उबलता है, जब भाप हवा जितना ज़ोर लगाए।",
   "start": 12.794,
   "end": 15.201,
   "peak": 0.773
  },
  {
   "i": 9,
   "text": "वहाँ पानी सौ नहीं, लगभग अट्ठासी डिग्री पर उबलता है।",
   "start": 15.401,
   "end": 18.312,
   "peak": 0.566
  },
  {
   "i": 10,
   "text": "तेज़ आग से भाप बढ़ती है, तापमान नहीं।",
   "start": 18.612,
   "end": 20.807,
   "peak": 0.743
  },
  {
   "i": 11,
   "text": "इसीलिए दाल गलती है, पर बहुत देर में।",
   "start": 21.007,
   "end": 23.141,
   "peak": 0.624
  },
  {
   "i": 12,
   "text": "जवाब सी!",
   "start": 23.491,
   "end": 24.251,
   "peak": 0.637
  },
  {
   "i": 13,
   "text": "मुख्य वजह कम प्रेशर।",
   "start": 24.451,
   "end": 25.816,
   "peak": 0.601
  },
  {
   "i": 14,
   "text": "ऑक्सीजन से उबाल तय नहीं होता, ठंड से भी नहीं।",
   "start": 26.116,
   "end": 28.824,
   "peak": 0.613
  },
  {
   "i": 15,
   "text": "इसका हल, प्रेशर कुकर।",
   "start": 29.174,
   "end": 30.503,
   "peak": 0.633
  },
  {
   "i": 16,
   "text": "लेह में कुकर के अंदर पानी लगभग एक सौ पंद्रह डिग्री तक पहुँचता है।",
   "start": 30.703,
   "end": 34.269,
   "peak": 0.639
  },
  {
   "i": 17,
   "text": "समय कुछ बढ़ाओ, प्रेशर पूरा निकलने पर ही खोलो।",
   "start": 34.469,
   "end": 36.977,
   "peak": 0.601
  },
  {
   "i": 18,
   "text": "ए, बी या सी?",
   "start": 37.277,
   "end": 38.2,
   "peak": 0.783
  },
  {
   "i": 19,
   "text": "कमेंट करो!",
   "start": 38.35,
   "end": 39.059,
   "peak": 0.578
  }
 ]
}