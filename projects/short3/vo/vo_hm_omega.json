{
 "voice": "kokoro:hm_omega",
 "speed": 1.34,
 "duration": 38.39,
 "sentences": [
  {
   "i": 0,
   "text": "लेह में दाल उबलती है...",
   "start": 0.0,
   "end": 1.248,
   "peak": 0.796
  },
  {
   "i": 1,
   "text": "फिर भी कच्ची क्यों?",
   "start": 1.498,
   "end": 2.599,
   "peak": 0.786
  },
  {
   "i": 2,
   "text": "ए, ऑक्सीजन कम?",
   "start": 2.999,
   "end": 4.085,
   "peak": 0.707
  },
  {
   "i": 3,
   "text": "बी, ठंड?",
   "start": 4.235,
   "end": 4.951,
   "peak": 0.722
  },
  {
   "i": 4,
   "text": "सी, प्रेशर कम?",
   "start": 5.101,
   "end": 6.057,
   "peak": 0.807
  },
  {
   "i": 5,
   "text": "जवाब एण्ड में।",
   "start": 6.357,
   "end": 7.29,
   "peak": 0.791
  },
  {
   "i": 6,
   "text": "लेह समुद्र से साढ़े तीन हज़ार मीटर ऊपर है।",
   "start": 7.79,
   "end": 10.524,
   "peak": 0.763
  },
  {
   "i": 7,
   "text": "वहाँ हवा का प्रेशर बस दो तिहाई।",
   "start": 10.774,
   "end": 12.558,
   "peak": 0.71
  },
  {
   "i": 8,
   "text": "पानी उबलता है, जब भाप हवा जितना ज़ोर लगाए।",
   "start": 12.858,
   "end": 15.173,
   "peak": 0.833
  },
  {
   "i": 9,
   "text": "वहाँ पानी सौ नहीं, लगभग अट्ठासी डिग्री पर उबलता है।",
   "start": 15.373,
   "end": 18.171,
   "peak": 0.638
  },
  {
   "i": 10,
   "text": "तेज़ आग से भाप बढ़ती है, तापमान नहीं।",
   "start": 18.471,
   "end": 20.637,
   "peak": 0.647
  },
  {
   "i": 11,
   "text": "इसीलिए दाल गलती है, पर बहुत देर में।",
   "start": 20.837,
   "end": 22.884,
   "peak": 0.726
  },
  {
   "i": 12,
   "text": "जवाब सी!",
   "start": 23.234,
   "end": 23.969,
   "peak": 0.781
  },
  {
   "i": 13,
   "text": "मुख्य वजह कम प्रेशर।",
   "start": 24.169,
   "end": 25.544,
   "peak": 0.739
  },
  {
   "i": 14,
   "text": "ऑक्सीजन से उबाल तय नहीं होता, ठंड से भी नहीं।",
   "start": 25.844,
   "end": 28.348,
   "peak": 0.804
  },
  {
   "i": 15,
   "text": "इसका हल, प्रेशर कुकर।",
   "start": 28.698,
   "end": 30.001,
   "peak": 0.725
  },
  {
   "i": 16,
   "text": "लेह में कुकर के अंदर पानी लगभग एक सौ पंद्रह डिग्री तक पहुँचता है।",
   "start": 30.201,
   "end": 33.756,
   "peak": 0.621
  },
  {
   "i": 17,
   "text": "समय कुछ बढ़ाओ, प्रेशर पूरा निकलने पर ही खोलो।",
   "start": 33.956,
   "end": 36.314,
   "peak": 0.685
  },
  {
   "i": 18,
   "text": "ए, बी या सी?",
   "start": 36.614,
   "end": 37.513,
   "peak": 0.73
  },
  {
   "i": 19,
   "text": "कमेंट करो!",
   "start": 37.663,
   "end": 38.36,
   "peak": 0.723
  }
 ]
}